package views

import (
	"nodal/internal/platform/database"
	"fmt"
	"strings"
)

// LeftSidebarContent renderiza el Sidebar izquierdo.
// Solo tiene dos bloques: Navegación y Temas (hashtags trending).
templ LeftSidebarContent(trends []database.Trend) {
	<aside class="sidebar hidden md:flex">
		<!-- 1. Menú principal (Navegación) -->
		<nav class="sidebar-nav">
			<a href="/" class="sidebar-nav-item">
				<span class="sidebar-nav-icon">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
				</span>
				Inicio
			</a>
			<a href="/explore" class="sidebar-nav-item">
				<span class="sidebar-nav-icon">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
				</span>
				Explorar
			</a>
			<a href="/profile" class="sidebar-nav-item">
				<span class="sidebar-nav-icon">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
				</span>
				Perfil
			</a>
		</nav>

		<!-- Divisor -->
		<div class="sidebar-divider"></div>

		<!-- 2. Temas (Trending hashtags) -->
		<div class="sidebar-category-group">
			<div style="font-size: var(--font-size-xs); font-weight: var(--font-weight-bold); color: var(--text-muted); margin-bottom: var(--space-3); text-transform: uppercase; letter-spacing: 0.08em; padding: 0 var(--space-2);">Temas</div>
			<nav style="display: flex; flex-direction: column; gap: var(--space-1);">
				for _, trend := range trends {
					<a href={ templ.SafeURL("/explore?q=" + trend.Name) } style="display: flex; align-items: center; gap: var(--space-2); padding: var(--space-2) var(--space-3); border-radius: var(--radius-md); text-decoration: none; color: var(--text-secondary); transition: background 0.15s ease, color 0.15s ease;" onmouseover="this.style.background='var(--bg-surface-hover)';this.style.color='var(--text-primary)';" onmouseout="this.style.background='';this.style.color='var(--text-secondary)';">
						<span style="display: inline-flex; align-items: center; color: var(--text-muted); flex-shrink: 0;">
							@TrendIcon(trend.Name)
						</span>
						<span style="font-weight: var(--font-weight-semibold); font-size: var(--font-size-sm); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
							#{ trend.Name }
						</span>
						<span style="font-size: var(--font-size-xs); color: var(--text-muted); margin-left: auto; flex-shrink: 0;">
							{ fmt.Sprintf("%d", trend.Count) }
						</span>
					</a>
				}
			</nav>
		</div>

		<!-- Footer de sidebar -->
		<div class="sidebar-footer">
			<span class="sidebar-footer-text">Nodal v0.1-alpha</span>
		</div>
	</aside>
}

// CompactPopularNode renderiza una fila compacta para el sidebar derecho.
// Estilo: avatar circular con inicial, título truncado, likes y botón "Ver".
templ CompactPopularNode(n database.Node) {
	<a href={ templ.SafeURL("/nodes/" + n.ID) } style="display: flex; align-items: center; gap: var(--space-3); padding: var(--space-2) var(--space-3); border-radius: var(--radius-md); text-decoration: none; transition: background 0.15s ease;" onmouseover="this.style.background='var(--bg-surface-hover)';" onmouseout="this.style.background='';">
		<!-- Avatar circular con inicial -->
		<div style="width: 36px; height: 36px; border-radius: 50%; background: linear-gradient(135deg, var(--accent-primary) 0%, var(--accent-secondary, #7c3aed) 100%); display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: var(--font-size-sm); font-weight: var(--font-weight-bold); color: white;">
			{ strings.ToUpper(string([]rune(n.Title)[0:1])) }
		</div>
		<!-- Título e info -->
		<div style="flex: 1; min-width: 0;">
			<div style="font-size: var(--font-size-sm); font-weight: var(--font-weight-semibold); color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
				{ n.Title }
			</div>
			<div style="display: flex; align-items: center; gap: var(--space-1); margin-top: 2px;">
				<svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--text-muted);"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
				<span style="font-size: var(--font-size-xs); color: var(--text-muted);">{ fmt.Sprintf("%d", n.LikesCount) } likes</span>
			</div>
		</div>
		<!-- Badge "Ver" -->
		<span style="font-size: 10px; font-weight: var(--font-weight-bold); color: var(--accent-primary); background: color-mix(in srgb, var(--accent-primary) 12%, transparent); padding: 2px 8px; border-radius: 99px; flex-shrink: 0; letter-spacing: 0.03em;">Ver</span>
	</a>
}

// RightSidebarContent renderiza el panel derecho.
// Bloque 1 (top): Tendencias de la Comunidad (dinámicas con emoji+título+subtítulo).
// Bloque 2 (bottom): Comunidades Populares (nodos compactos ordenados por likes).
templ RightSidebarContent(popularNodes []database.Node, trends []database.TrendingTopic) {
	<aside class="widgets-sidebar flex flex-col gap-6 w-80 flex-shrink-0 hidden lg:flex">

		<!-- Bloque 1: TENDENCIAS (arriba) -->
		<div class="widget-box w-full">
			<h3 class="widget-title" style="display: flex; align-items: center; gap: var(--space-2); margin-bottom: var(--space-3);">
				<span style="display: inline-flex; align-items: center; color: var(--text-muted);">
					<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
				</span>
				Tendencias
			</h3>
			<div style="display: flex; flex-direction: column; gap: var(--space-2);">
				if len(trends) == 0 {
					<p style="font-size: var(--font-size-xs); color: var(--text-muted); padding: var(--space-2) var(--space-3);">No hay tendencias activas.</p>
				}
				for _, trend := range trends {
					<a href={ templ.SafeURL("/explore?q=" + trend.Category) } style="text-decoration: none; display: block; color: inherit;">
						@CommunityTrendItem(trend.Emoji, trend.Title, trend.Subtitle)
					</a>
				}
			</div>
		</div>

		<!-- Bloque 2: COMUNIDADES POPULARES (abajo) -->
		<div class="widget-box w-full">
			<h3 class="widget-title" style="display: flex; align-items: center; gap: var(--space-2); margin-bottom: var(--space-3);">
				<span style="display: inline-flex; align-items: center; color: var(--text-muted);">
					<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
				</span>
				Comunidades Populares
			</h3>
			<div style="display: flex; flex-direction: column; gap: var(--space-1);">
				if len(popularNodes) == 0 {
					<p style="font-size: var(--font-size-xs); color: var(--text-muted); padding: var(--space-2) var(--space-3);">Aún no hay nodos populares.</p>
				}
				for _, n := range popularNodes {
					@CompactPopularNode(n)
				}
			</div>
		</div>

	</aside>
}


// CommunityTrendItem renderiza una fila de tendencia estilizada en el panel derecho.
templ CommunityTrendItem(emoji string, title string, subtitle string) {
	<div style="display: flex; align-items: flex-start; gap: var(--space-3); padding: var(--space-2) var(--space-3); border-radius: var(--radius-md); cursor: pointer; transition: background 0.15s ease;" onmouseover="this.style.background='var(--bg-surface-hover)';" onmouseout="this.style.background='';">
		<span style="font-size: 18px; line-height: 1; flex-shrink: 0; margin-top: 2px;">{ emoji }</span>
		<div style="min-width: 0;">
			<div style="font-size: var(--font-size-sm); font-weight: var(--font-weight-semibold); color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">{ title }</div>
			<div style="font-size: var(--font-size-xs); color: var(--text-muted); margin-top: 1px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">{ subtitle }</div>
		</div>
	</div>
}

// TrendIcon renderiza iconos dinámicos SVG en base al nombre de la tendencia.
templ TrendIcon(name string) {
	switch getIconType(name) {
		case "gaming":
			<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="6" x2="10" y1="12" y2="12"/><line x1="8" x2="8" y1="10" y2="14"/><line x1="15" x2="15.01" y1="13" y2="13"/><line x1="18" x2="18.01" y1="11" y2="11"/><rect width="20" height="12" x="2" y="6" rx="3"/></svg>
		case "manga":
			<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275Z"/><path d="m5 3 1 2.5L8.5 6 6 7 5 9.5 4 7 1.5 6 4 5.5Z"/><path d="m19 17 1 2.5 2.5.5-2.5 1-1 2.5-1-2.5-2.5-1 2.5-1Z"/></svg>
		case "ia":
			<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect width="16" height="16" x="4" y="4" rx="2"/><rect width="6" height="6" x="9" y="9" rx="1"/><path d="M9 1v3"/><path d="M15 1v3"/><path d="M9 20v3"/><path d="M15 20v3"/><path d="M20 9h3"/><path d="M20 15h3"/><path d="M1 9h3"/><path d="M1 15h3"/></svg>
		default:
			<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="9" y2="9"/><line x1="4" x2="20" y1="15" y2="15"/><line x1="10" x2="8" y1="3" y2="21"/><line x1="16" x2="14" y1="3" y2="21"/></svg>
	}
}

// getIconType retorna la categoría temática de la tendencia.
func getIconType(name string) string {
	nameLower := strings.ToLower(name)
	if strings.Contains(nameLower, "valorant") || strings.Contains(nameLower, "pokemon") || strings.Contains(nameLower, "gaming") || strings.Contains(nameLower, "lol") {
		return "gaming"
	}
	if strings.Contains(nameLower, "manga") || strings.Contains(nameLower, "anime") || strings.Contains(nameLower, "onepiece") || strings.Contains(nameLower, "naruto") {
		return "manga"
	}
	if strings.Contains(nameLower, "ia") || strings.Contains(nameLower, "rag") || strings.Contains(nameLower, "python") || strings.Contains(nameLower, "dev") || strings.Contains(nameLower, "ai") {
		return "ia"
	}
	return "default"
}
