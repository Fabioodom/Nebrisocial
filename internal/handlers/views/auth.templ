package views

// Login renderiza la página de inicio de sesión.
// El formulario usa htmx para enviar a POST /auth/login sin recarga de página.
// Si el servidor devuelve un fragmento de error HTML, se muestra en #auth-error.
// Si el login es exitoso, htmx recibe HX-Redirect y redirige a /.
templ Login() {
    @Layout() {
        <div class="auth-card">
            <h1 class="auth-title">Iniciar Sesión</h1>
            <p class="auth-subtitle">Bienvenido de vuelta a <strong>Nodal</strong></p>

            <!-- Div de errores: htmx inyectará aquí el fragmento de error del servidor -->
            <div id="auth-error" class="auth-error" style="display:none"></div>

            <form
                hx-post="/auth/login"
                hx-target="#auth-error"
                hx-swap="innerHTML"
                hx-on::after-request="handleAuthResponse(event)"
                class="auth-form"
            >
                <div class="form-group">
                    <label for="login-email">Email</label>
                    <input
                        id="login-email"
                        type="email"
                        name="email"
                        placeholder="tu@email.com"
                        required
                        autocomplete="email"
                    />
                </div>

                <div class="form-group">
                    <label for="login-password">Contraseña</label>
                    <input
                        id="login-password"
                        type="password"
                        name="password"
                        placeholder="••••••••"
                        required
                        autocomplete="current-password"
                        minlength="8"
                    />
                </div>

                <button type="submit" class="btn-primary" id="login-submit">
                    <span class="btn-text">Entrar</span>
                    <span class="btn-spinner" style="display:none">⟳</span>
                </button>
            </form>

            <div class="auth-divider"><span>o continúa con</span></div>

            <div class="oauth-buttons">
                <a href="/auth/google/login" class="btn-oauth btn-google">
                    <svg width="18" height="18" viewBox="0 0 48 48"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.97 2.31-8.16 2.31-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
                    Google
                </a>
                <a href="/auth/github/login" class="btn-oauth btn-github">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
                    GitHub
                </a>
            </div>

            <p class="auth-switch">
                ¿No tienes cuenta? <a href="/register">Regístrate aquí</a>
            </p>
        </div>

        <script>
        // Tras cada request htmx al formulario de auth, mostramos/ocultamos el error
        function handleAuthResponse(event) {
            const errorDiv = document.getElementById('auth-error');
            if (event.detail.successful) {
                // El servidor puede devolver HX-Redirect; si no, redirigimos nosotros
                errorDiv.style.display = 'none';
            } else {
                errorDiv.style.display = 'block';
            }
        }
        </script>
    }
}

// Register renderiza la página de registro de nuevos usuarios.
// Idéntica estrategia htmx: POST a /auth/register, errores en #auth-error.
templ Register() {
    @Layout() {
        <div class="auth-card">
            <h1 class="auth-title">Crear Cuenta</h1>
            <p class="auth-subtitle">Únete a <strong>Nodal</strong> hoy</p>

            <div id="auth-error" class="auth-error" style="display:none"></div>

            <form
                hx-post="/auth/register"
                hx-target="#auth-error"
                hx-swap="innerHTML"
                hx-on::after-request="handleAuthResponse(event)"
                class="auth-form"
            >
                <div class="form-group">
                    <label for="reg-username">Nombre de usuario</label>
                    <input
                        id="reg-username"
                        type="text"
                        name="username"
                        placeholder="tu_usuario"
                        required
                        maxlength="30"
                        pattern="[a-zA-Z0-9_]+"
                        title="Solo letras, números y guiones bajos"
                        autocomplete="username"
                    />
                </div>

                <div class="form-group">
                    <label for="reg-email">Email</label>
                    <input
                        id="reg-email"
                        type="email"
                        name="email"
                        placeholder="tu@email.com"
                        required
                        autocomplete="email"
                    />
                </div>

                <div class="form-group">
                    <label for="reg-password">Contraseña <small>(mín. 8 caracteres)</small></label>
                    <input
                        id="reg-password"
                        type="password"
                        name="password"
                        placeholder="••••••••"
                        required
                        minlength="8"
                        autocomplete="new-password"
                    />
                </div>

                <button type="submit" class="btn-primary" id="register-submit">
                    <span class="btn-text">Crear cuenta</span>
                    <span class="btn-spinner" style="display:none">⟳</span>
                </button>
            </form>

            <div class="auth-divider"><span>o regístrate con</span></div>

            <div class="oauth-buttons">
                <a href="/auth/google/login" class="btn-oauth btn-google">
                    <svg width="18" height="18" viewBox="0 0 48 48"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.97 2.31-8.16 2.31-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
                    Google
                </a>
                <a href="/auth/github/login" class="btn-oauth btn-github">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
                    GitHub
                </a>
            </div>

            <p class="auth-switch">
                ¿Ya tienes cuenta? <a href="/login">Inicia sesión</a>
            </p>
        </div>

        <script>
        function handleAuthResponse(event) {
            const errorDiv = document.getElementById('auth-error');
            if (event.detail.successful) {
                errorDiv.style.display = 'none';
            } else {
                errorDiv.style.display = 'block';
            }
        }
        </script>
    }
}
