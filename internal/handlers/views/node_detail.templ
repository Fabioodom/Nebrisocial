package views

import (
	"nodal/internal/platform/database"
	"fmt"
	"sort"
	"strings"
	"time"
)

// timelineItem es una entrada unificada del timeline: puede ser un ChatMessage o un Thread IA.
type timelineItem struct {
	Kind      string           // "chat" | "ai"
	Chat      *database.ChatMessage
	Thread    *database.Thread
	Timestamp time.Time
}

// buildTimeline mezcla mensajes de chat e hilos IA ordenados cronológicamente.
func buildTimeline(messages []database.ChatMessage, threads []database.Thread) []timelineItem {
	items := make([]timelineItem, 0, len(messages)+len(threads))
	for i := range messages {
		items = append(items, timelineItem{Kind: "chat", Chat: &messages[i], Timestamp: messages[i].CreatedAt})
	}
	for i := range threads {
		items = append(items, timelineItem{Kind: "ai", Thread: &threads[i], Timestamp: threads[i].CreatedAt})
	}
	sort.Slice(items, func(i, j int) bool {
		return items[i].Timestamp.Before(items[j].Timestamp)
	})
	return items
}

// NodeDetail renderiza la página de detalle de un Nodo con chat e hilos IA intercalados.
// Usa LayoutWithMarkdown para incluir marked.js (renderizado de resúmenes IA).
templ NodeDetail(node *database.Node, messages []database.ChatMessage, threads []database.Thread, isAuthenticated bool) {
    @LayoutWithMarkdown() {
        <!-- Cargar extensión WebSocket de HTMX -->
        <script src="https://unpkg.com/htmx.org/dist/ext/ws.js"></script>

        <div class="node-detail-container">
            <!-- Breadcrumb + Header del Nodo -->
            <div class="node-detail-header">
                <div class="breadcrumb">
                    <a href="/">&#8592; Inicio</a>
                    <span>/</span>
                    <span>Nodo</span>
                </div>
                <div class="node-detail-title-row">
                    <h1 class="node-title">{ node.Title }</h1>
                    if node.Category != "" {
                        <span class={ "node-meta-badge", "category-" + strings.ToLower(node.Category) }>{ node.Category }</span>
                    }
                </div>
                if node.Description != "" {
                    <div class="node-description">{ node.Description }</div>
                }
            </div>

            <!-- Timeline unificado: chat + resúmenes IA (conectado vía WebSockets) -->
            <div class="chat-section" hx-ext="ws" ws-connect={ "/nodes/" + node.ID + "/ws" }>
                <div class="chat-section-title">
                    &#128172; Timeline del Nodo
                    <span style="font-size:var(--font-size-xs); font-weight:var(--font-weight-normal); color:var(--text-muted); margin-left:auto;">
                        { fmt.Sprintf("%d", len(messages)) } mensaje(s) · { fmt.Sprintf("%d", len(threads)) } resumen(es) IA
                    </span>
                </div>

                <div class="chat-timeline" id="chat-messages">
                    if len(messages) == 0 && len(threads) == 0 {
                        <div class="chat-empty" id="chat-empty">
                            Sin mensajes aún. ¡Escribe el primero para activar al Agente Cronista!
                        </div>
                    } else {
                        <!-- Timeline ordenado cronológicamente (chat + IA intercalados) -->
                        for _, item := range buildTimeline(messages, threads) {
                            if item.Kind == "chat" {
                                @ChatMessageItem(item.Chat)
                            } else {
                                <!-- Resumen IA renderizado con Markdown -->
                                <div class="ai-summary-card ai-embed">
                                    <div class="ai-summary-header">
                                        <span class="ai-badge">&#129302; Resumen IA</span>
                                        if item.Thread.Title != "" {
                                            <span class="ai-summary-title">{ item.Thread.Title }</span>
                                        }
                                        <span class="ai-summary-time">{ item.Thread.CreatedAt.Format("02 Jan 15:04") }</span>
                                    </div>
                                    <!-- data-md almacena el Markdown crudo; JS lo renderiza en .ai-summary-body -->
                                    <div class="ai-summary-body" data-md={ item.Thread.Body }></div>
                                </div>
                            }
                        }
                    }
                </div>

                <!-- Área de input del chat (envía por HTTP POST convencional, la actualización llega por WS) -->
                <div class="chat-input-area">
                    <form
                        id="chat-form"
                        hx-post={ "/nodes/" + node.ID + "/chat" }
                        hx-swap="none"
                        hx-on::after-request="
                            if(event.detail.successful) {
                                document.getElementById('chat-input').value='';
                                document.getElementById('chat-counter').textContent='0/500';
                            }
                        "
                        class="chat-form"
                    >
                        <textarea
                            id="chat-input"
                            name="content"
                            class="chat-textarea"
                            placeholder="Escribe un mensaje al nodo&#8230;"
                            maxlength="500"
                            rows="1"
                            required
                            oninput="document.getElementById('chat-counter').textContent=this.value.length+'/500';
                                     this.style.height='auto'; this.style.height=Math.min(this.scrollHeight,80)+'px';"
                            onkeydown="if(event.key==='Enter'&&!event.shiftKey){event.preventDefault();this.form.requestSubmit();}"
                        ></textarea>
                        <button type="submit" class="chat-send-btn" id="chat-send" aria-label="Enviar mensaje">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                                <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"></path>
                            </svg>
                        </button>
                    </form>
                    <div class="chat-counter" id="chat-counter">0/500</div>

                    <div class="cronista-hint">
                        &#128196; El <strong>Agente Cronista</strong> se activa al llegar a <strong>5 mensajes</strong> y genera un resumen Markdown del chat.
                    </div>
                </div>
            </div>
        </div>

        <!-- Renderizado de Markdown y auto-scroll -->
        <script>
        (function() {
            function renderMarkdown() {
                document.querySelectorAll('.ai-summary-body[data-md]').forEach(function(el) {
                    if (el.dataset.rendered) return;
                    var raw = el.getAttribute('data-md') || '';
                    if (typeof marked !== 'undefined' && raw) {
                        el.innerHTML = marked.parse(raw, { breaks: true, gfm: true });
                    } else if (raw) {
                        // Fallback: preservar saltos de línea si marked no cargó aún
                        el.innerHTML = raw.replace(/\n/g, '<br>');
                    }
                    el.dataset.rendered = '1';
                });
            }

            // Render inicial
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', renderMarkdown);
            } else {
                renderMarkdown();
            }

            // Re-render tras cualquier swap de HTMX (nuevas tarjetas IA vía WebSocket u oob)
            document.addEventListener('htmx:afterSwap', renderMarkdown);

            // Auto-scroll al fondo del timeline al cargar y ante cambios en el timeline
            var msgs = document.getElementById('chat-messages');
            if (msgs) {
                msgs.scrollTop = msgs.scrollHeight;
                var observer = new MutationObserver(function() {
                    msgs.scrollTop = msgs.scrollHeight;
                    var empty = document.getElementById('chat-empty');
                    if (empty) empty.remove();
                });
                observer.observe(msgs, { childList: true });
            }
        })();
        </script>
    }
}

// ChatMessageItem es un mensaje de chat formateado al estilo timeline de Discord.
templ ChatMessageItem(m *database.ChatMessage) {
    <div class="chat-message" style="animation: fadeInFast 0.25s ease;">
        <div class="chat-avatar">👤</div>
        <div class="chat-message-body">
            <div class="chat-message-header">
                <span class="chat-message-author">Anónimo</span>
                <span class="chat-message-time">{ m.CreatedAt.Format("15:04") }</span>
            </div>
            <div class="chat-message-text">{ m.Content }</div>
        </div>
    </div>
}

// ChatMessageBroadcast es el fragmento HTML enviado vía WebSocket para inserción OOB.
templ ChatMessageBroadcast(m *database.ChatMessage) {
    <div id="chat-messages" hx-swap-oob="beforeend">
        @ChatMessageItem(m)
    </div>
}
